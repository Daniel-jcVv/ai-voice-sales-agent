# Header name for webhook authentication
X_API_KEY=x-api-key

# Secret value for webhook auth (generate: openssl rand -hex 24)
SECRET_KEY=your-secret-here

# ngrok public URL (run: ngrok http 5678)
PUBLIC_URL_NGROK=https://your-subdomain.ngrok-free.dev

# n8n webhook URL for order lookups
URL_WEBHOOK_GET_N8N=https://your-subdomain.ngrok-free.dev/webhook/my-store/orders

# n8n webhook URL for product queries (includes auth as query param)
URL_ELEVENLABS=https://your-subdomain.ngrok-free.dev/webhook/my-store/products?x-api-key=your-secret-here

# n8n API key (generate: n8n Settings > API > Create API Key)
N8N_API_KEY_NAME=internal
N8N_API_KEY=your-n8n-api-key

# ElevenLabs API key (generate: ElevenLabs Dashboard > Developers > Create API Key)
ELEVENLABS_API_KEY_NAME=voice-agent-n8n
ELEVENLABS_API_KEY=sk_your-elevenlabs-api-key
